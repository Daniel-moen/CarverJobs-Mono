# Build backend
FROM golang:1.23-alpine AS backend-builder

WORKDIR /app/backend

# Install build dependencies
RUN apk add --no-cache gcc musl-dev git

# Copy go mod files first for better caching
COPY backend/go.mod backend/go.sum ./

# Download dependencies
RUN go mod download

# Copy backend source code
COPY backend/ ./

# Build the binary
RUN CGO_ENABLED=1 GOOS=linux go build -v -a -installsuffix cgo -o /main ./cmd/server

# Build frontend
FROM node:18-alpine AS frontend-builder

WORKDIR /app/frontend

# Copy package files first for better caching
COPY frontend/package.json frontend/package-lock.json ./

# Install dependencies
RUN npm ci --silent

# Copy frontend source code
COPY frontend/ ./

# Build static site (SvelteKit adapter-static already configured)
ENV NODE_ENV=production
RUN npm run build

# Production stage (no Node app needed at runtime, only nginx + go api)
FROM alpine:3.20

# Install runtime dependencies
RUN apk --no-cache add ca-certificates tzdata wget supervisor nginx

# Copy backend binary
COPY --from=backend-builder /main /usr/local/bin/go-api

# Copy backend migrations (path inside backend-builder is /app/backend/migrations)
COPY --from=backend-builder /app/backend/migrations /app/migrations

# Copy frontend build to nginx web root
RUN mkdir -p /usr/share/nginx/html
COPY --from=frontend-builder /app/frontend/build/ /usr/share/nginx/html/

# Create data directory for SQLite
RUN mkdir -p /app/data

# Copy production configurations
COPY nginx.railway.prod.conf /etc/nginx/nginx.conf
COPY supervisord.railway.conf /etc/supervisor/conf.d/supervisord.conf

# Expose port
EXPOSE 8080

# Start supervisor
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"] 
