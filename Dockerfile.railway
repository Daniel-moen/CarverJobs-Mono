# Build backend
FROM golang:1.23-alpine AS backend-builder

WORKDIR /app/backend

# Install build dependencies
RUN apk add --no-cache gcc musl-dev git

# Copy go mod files first for better caching
COPY backend/go.mod backend/go.sum ./

# Download dependencies
RUN go mod download

# Copy backend source code
COPY backend/ ./

# Build the binary
RUN CGO_ENABLED=1 GOOS=linux go build -v -a -installsuffix cgo -o /main ./cmd/server

# Build frontend
FROM node:18-alpine AS frontend-builder

WORKDIR /app/frontend

# Copy package files first for better caching
COPY frontend/package.json frontend/package-lock.json ./

# Install dependencies
RUN npm ci --silent

# Copy frontend source code
COPY frontend/ ./

# Production stage
FROM node:18-alpine

# Install runtime dependencies
RUN apk --no-cache add ca-certificates tzdata wget supervisor nginx

# Copy backend binary
COPY --from=backend-builder /main /usr/local/bin/go-api

# Copy backend migrations (path inside backend-builder is /app/backend/migrations)
COPY --from=backend-builder /app/backend/migrations /app/migrations

# Copy frontend app
COPY --from=frontend-builder /app/frontend /app/frontend

# Set working directory for frontend
WORKDIR /app/frontend

# Create data directory for SQLite
RUN mkdir -p /app/data

# Copy configurations (Railway uses localhost targets inside single container)
COPY nginx.railway.conf /etc/nginx/nginx.conf
COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Expose port
EXPOSE 8080

# Start supervisor
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"] 