# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=production
AUTO_LOGIN_AS_ADMIN=false
SECRET_KEY=replace-with-a-long-random-secret
SESSION_SECURE_COOKIE=true
# Frontend launch gate (true = live app, false = waitlist-only page)
VITE_SITE_LAUNCHED=true
# Website feedback prompt delay (hours since account creation before it can appear)
FEEDBACK_MIN_ACCOUNT_AGE_HOURS=24
# Shown on Terms, Privacy, and data deletion pages (mailto links)
VITE_SUPPORT_EMAIL=support@jobcarver.co

# ── Mixpanel (product analytics) ──────────────────────────────────────────────
# Project token from Project Settings — set in real .env / hosting only (never commit).
VITE_MIXPANEL_TOKEN=
# EU project (dashboard snippet): use both below.
# US project: https://api.mixpanel.com
VITE_MIXPANEL_API_HOST=https://api-eu.mixpanel.com
# Autocapture (clicks, scrolls, etc.). SPA page views still come from app code (trackPageView).
VITE_MIXPANEL_AUTOCAPTURE=true
# Session replay sampling 0–100 (dashboard snippet often uses 100). Set >0 to enable recording.
VITE_MIXPANEL_SESSION_RECORD_PERCENT=100
# Server-side tracking (LLM usage, WhatsApp metadata). Prefer MIXPANEL_PROJECT_TOKEN
# per service; falls back to VITE_MIXPANEL_TOKEN when unset.
MIXPANEL_PROJECT_TOKEN=
MIXPANEL_API_HOST=https://api-eu.mixpanel.com
# Keep prompt/output capture off by default — LLM inputs can include user docs.
MIXPANEL_LLM_CAPTURE_CONTENT=false
# Optional overrides for backend OpenAI usage events
# MIXPANEL_LLM_DISTINCT_ID=carver-api
# MIXPANEL_LLM_EVENT_NAME=openai_chat_completion

# Comma-separated list of allowed hostnames. Defaults to * locally; set this to
# your Railway/custom domains in production to enable trusted host enforcement.
# ALLOWED_HOSTS=your-app.up.railway.app,your-custom-domain.com
# Comma-separated list of allowed CORS origins (your frontend URL)
CORS_ORIGINS=https://your-frontend.com

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-password

# ── Google OAuth (optional) ───────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
# Optional restrictions (leave blank to allow any verified Google account):
GOOGLE_ALLOWED_EMAILS=
GOOGLE_ALLOWED_DOMAIN=
GOOGLE_REQUIRE_VERIFIED_EMAIL=true

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── WhatsApp Bot — Meta Cloud API ─────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
# Single id, or comma-separated ids if this app has multiple WhatsApp numbers (same access token).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
META_VERIFY_TOKEN=replace-with-your-verify-token

# Your public frontend URL — used in magic links sent via WhatsApp
FRONTEND_BASE_URL=https://your-frontend.com
WA_MAGIC_TOKEN_TTL_SECONDS=1800

# ── Yoco — Checkout API (CARVER Pro) ──────────────────────────────────────────
# Secret key from Yoco app → Payment gateway (sk_test_… or sk_live_…)
YOCO_SECRET_KEY=
# Webhook signing secret from Yoco (whsec_…); required for POST /subscription/webhook
YOCO_WEBHOOK_SECRET=
# Amount in ZAR as decimal string (charged once per checkout; register webhook URL in Yoco dashboard)
YOCO_MONTHLY_AMOUNT=200.00

# ── Telnyx — Inbound SMS ──────────────────────────────────────────────────────
TELNYX_API_KEY=
# Mission Control → API keys → Public key (Ed25519, base64 or PEM). Required in production.
TELNYX_PUBLIC_KEY=
TELNYX_PHONE_NUMBER=+1xxxxxxxxxx

# ── Apify (Facebook group scraper) ────────────────────────────────────────────
APIFY_API_KEY=
APIFY_ACTOR_IDS=apify/facebook-groups-scraper
APIFY_START_URLS=https://www.facebook.com/groups/yachtcrew
APIFY_MAX_ITEMS=500
APIFY_SCRAPE_ON_STARTUP=false

# ── Scrape.do (JS-rendered scraping proxy) ────────────────────────────────────
SCRAPE_DO_TOKEN=
SCRAPE_DO_URLS=
SCRAPE_DO_RENDER=false

# ── Web job board scrapers ─────────────────────────────────────────────────────
DOCKWALK_ENABLED=true
WORKONAYACHT_ENABLED=true
CREWFINDERS_ENABLED=false
VIKINGCREW_ENABLED=false
FASTSTREAM_ENABLED=true
SUPERYACHTTIMES_ENABLED=false

# ── Shadow traffic capture (Go-port migration validation) ─────────────────────
# Records real requests to a JSONL corpus so jobcarver-go can be replayed and
# diffed before cutover. OFF by default; zero overhead when disabled.
# See jobcarver-go/SHADOW.md. NOTE: the corpus contains request bodies — treat
# it as sensitive (sensitive JSON fields are redacted, cookies are dropped).
SHADOW_CAPTURE_ENABLED=false
SHADOW_CAPTURE_FILE=data/shadow_capture.jsonl
SHADOW_CAPTURE_SAMPLE_RATE=1.0
SHADOW_CAPTURE_MAX_BODY_BYTES=65536
SHADOW_CAPTURE_RESPONSE_BODY=false
SHADOW_CAPTURE_EXCLUDE_PREFIXES=/health,/metrics,/admin/dashboard/static

# ── Go canary routing (serve live traffic from jobcarver-go) ──────────────────
# Runs the Go port alongside this API and serves a slice of real traffic from it.
# OFF by default; no-op until GO_UPSTREAM_URL points at the Go service.
# Routing: unimplemented-in-Go routes always stay on Python; flagged users
# (users.route_to_go, toggle via PATCH /admin/users/{id}/routing) get Go for all
# Go-implemented routes; everyone else gets Go GO_ROUTING_PERCENT% of the time.
# See jobcarver-go/SHADOW.md (Canary section).
GO_ROUTING_ENABLED=false
GO_UPSTREAM_URL=
GO_ROUTING_PERCENT=20
GO_ROUTING_TIMEOUT_SECONDS=15
GO_UNIMPLEMENTED_PREFIXES=/auth/google,/jobs/submit/text,/jobs/submit/image,/scraper,/interview,/crew-match,/matching,/documents,/subscription,/telnyx,/webhooks,/admin/jobs/review
