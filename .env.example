# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=production
AUTO_LOGIN_AS_ADMIN=false
SECRET_KEY=replace-with-a-long-random-secret
SESSION_SECURE_COOKIE=true
# Frontend launch gate (true = live app, false = waitlist-only page)
VITE_SITE_LAUNCHED=true
# Website feedback prompt delay (hours since account creation before it can appear)
FEEDBACK_MIN_ACCOUNT_AGE_HOURS=24
# Shown on Terms, Privacy, and data deletion pages (mailto links)
VITE_SUPPORT_EMAIL=support@jobcarver.co

# ── PostHog (frontend product analytics) ──────────────────────────────────────
# Project API key (phc_...). Safe to expose to the browser, but still loaded
# from env so it can be swapped per environment. Leave blank to disable.
VITE_POSTHOG_KEY=
# EU cloud: https://eu.i.posthog.com  |  US cloud (default): https://us.i.posthog.com
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Session replay records user screens — keep OFF unless you have consent.
VITE_POSTHOG_SESSION_RECORDING=false
# Backend LLM usage capture for PostHog LLM Analytics. Uses VITE_POSTHOG_KEY/HOST
# as fallback, but set these explicitly per backend environment when possible.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Keep prompt/output capture off by default because LLM inputs can include user docs.
POSTHOG_LLM_CAPTURE_CONTENT=false

# Comma-separated list of allowed hostnames. Defaults to * locally; set this to
# your Railway/custom domains in production to enable trusted host enforcement.
# ALLOWED_HOSTS=your-app.up.railway.app,your-custom-domain.com
# Comma-separated list of allowed CORS origins (your frontend URL)
CORS_ORIGINS=https://your-frontend.com

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-password

# ── Google OAuth (optional) ───────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
# Optional restrictions (leave blank to allow any verified Google account):
GOOGLE_ALLOWED_EMAILS=
GOOGLE_ALLOWED_DOMAIN=
GOOGLE_REQUIRE_VERIFIED_EMAIL=true

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── WhatsApp Bot — Meta Cloud API ─────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
# Single id, or comma-separated ids if this app has multiple WhatsApp numbers (same access token).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
META_VERIFY_TOKEN=replace-with-your-verify-token

# Your public frontend URL — used in magic links sent via WhatsApp
FRONTEND_BASE_URL=https://your-frontend.com
WA_MAGIC_TOKEN_TTL_SECONDS=1800

# ── Yoco — Checkout API (CARVER Pro) ──────────────────────────────────────────
# Secret key from Yoco app → Payment gateway (sk_test_… or sk_live_…)
YOCO_SECRET_KEY=
# Webhook signing secret from Yoco (whsec_…); required for POST /subscription/webhook
YOCO_WEBHOOK_SECRET=
# Amount in ZAR as decimal string (charged once per checkout; register webhook URL in Yoco dashboard)
YOCO_MONTHLY_AMOUNT=200.00

# ── Telnyx — Inbound SMS ──────────────────────────────────────────────────────
TELNYX_API_KEY=
# Mission Control → API keys → Public key (Ed25519, base64 or PEM). Required in production.
TELNYX_PUBLIC_KEY=
TELNYX_PHONE_NUMBER=+1xxxxxxxxxx

# ── Apify (Facebook group scraper) ────────────────────────────────────────────
APIFY_API_KEY=
APIFY_ACTOR_IDS=apify/facebook-groups-scraper
APIFY_START_URLS=https://www.facebook.com/groups/yachtcrew
APIFY_MAX_ITEMS=500
APIFY_SCRAPE_ON_STARTUP=false

# ── Scrape.do (JS-rendered scraping proxy) ────────────────────────────────────
SCRAPE_DO_TOKEN=
SCRAPE_DO_URLS=
SCRAPE_DO_RENDER=false

# ── Web job board scrapers ─────────────────────────────────────────────────────
DOCKWALK_ENABLED=true
WORKONAYACHT_ENABLED=true
CREWFINDERS_ENABLED=false
VIKINGCREW_ENABLED=false
FASTSTREAM_ENABLED=true
SUPERYACHTTIMES_ENABLED=false
